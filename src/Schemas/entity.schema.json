{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.allascode.institute/entity.schema.json",
  "title": "Entity",
  "type": "object",
  "required": ["id", "canonical_label", "kind", "version", "properties"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "canonical_label": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["sdk", "package", "runtime", "protocol", "transport", "schema", "behavior"] },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "properties": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "behaviors": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "channels": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
